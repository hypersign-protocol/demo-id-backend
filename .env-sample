SSI_API_SECRET=your_ssi_api_secret
KYC_API_SECRET=your_kyc_api_secret
KYC_BASE_URL=https://your-kyc-service-url
SSI_BASE_URL=https://your-ssi-service-url
DEVELOPER_DASHBOARD_SERVICE_BASE_URL=https://your-developer-dashboard-service-url
WIDGET_URL=https://your-widget-url

ISSUER_DID=did:hid:your-issuer-did
ISSUER_VERMETHOD_ID=did:hid:your-issuer-did#key-1

# Used when useCase/usecase is "beerkart" or "bankify".
BEERKART_WIDGET_CONFIG_ID=your_beerkart_widget_config_id
BANKIFY_WIDGET_CONFIG_ID=your_bankify_widget_config_id

# NuVex intentionally has no widget configuration ID.
